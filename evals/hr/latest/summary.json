      "sql": "SELECT\n    d.department_name,\n    e.term_count AS 离职人数,\n    e.begin_count AS 期初在职人数,\n    ROUND(e.term_count * 100.0 / NULLIF(e.begin_count, 0), 2) AS 离职率\nFROM departments d\nINNER JOIN (\n    SELECT\n        department_id,\n        SUM(CASE WHEN termination_date >= '2025-10-29' AND termination_date <= '2026-10-28' THEN 1 ELSE 0 END) AS term_count,\n        SUM(CASE WHEN hire_date <= '2025-10-29' AND (termination_date IS NULL OR termination_date > '2025-10-29') THEN 1 ELSE 0 END) AS begin_count\n    FROM employees\n    GROUP BY department_id\n) e ON d.department_id = e.department_id\nORDER BY 离职率 DESC;",
