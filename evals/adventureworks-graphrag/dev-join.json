      "difficulty": "hard",
      "required_tables": ["Sales.SalesOrderHeader", "Person.Address", "Person.StateProvince"],
      "required_intermediate_tables": [],
      "acceptable_join_paths": [
        "SalesOrderHeader.ShipToAddressID -> Address.AddressID",
        "Address.StateProvinceID -> StateProvince.StateProvinceID"
