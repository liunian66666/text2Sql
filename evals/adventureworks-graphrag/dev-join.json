      "role_sensitive": true,
      "expect_ambiguity": true,
      "role_note": "SalesOrderHeader 与 Address 之间有 BillToAddressID / ShipToAddressID 两个外键角色；问的是收货，必须用 ShipToAddressID。",
      "validation_rules": ["必须选择 ShipToAddressID 角色", "不得使用 BillToAddressID"]
    },
    {
