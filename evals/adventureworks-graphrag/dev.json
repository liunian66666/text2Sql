    {
      "id": "AW-DEV-010",
      "question": "统计当前库存低于再订货点的商品数量（必须先把多库位库存聚合到商品粒度）。",
      "category": "grain_conflict",
      "difficulty": "hard",
      "required_tables": [
        "Production.ProductInventory",
        "Production.Product"
      ],
      "required_intermediate_tables": [],
      "acceptable_join_paths": [],
      "policy_evidence": [
        "POL-INV-002#3.1",
        "POL-INV-001#4.1"
      ],
      "key_conclusion": "按商品聚合后共 7 个商品低于再订货点",
      "validation_rules": [
        "ProductInventory 主键 (ProductID, LocationID)",
        "禁止逐库位 Quantity 与 ReorderPoint 比较",
        "先 GROUP BY ProductID 再 JOIN"
      ],
      "counter_example_key": null,
      "database_id": "adventureworks",
      "reference_sql": "SELECT COUNT(*) AS n FROM (SELECT \"ProductID\", SUM(\"Quantity\") AS qty FROM \"Production.ProductInventory\" GROUP BY \"ProductID\") inv JOIN \"Production.Product\" p ON inv.\"ProductID\"=p.\"ProductID\" WHERE inv.qty < p.\"ReorderPoint\"",
      "reference_result": {
        "columns": [
          "n"
        ],
        "rows": [
          [
            7
          ]
        ]
      },
      "counter_example": null,
      "split": "dev",
      "reference_sql_verified": true
