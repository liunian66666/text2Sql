    {
      "id": "AW-DEV-008",
      "question": "按订单日期匹配历史成本区间，统计 2023 年 1 月订单明细匹配到的成本记录数与成本合计。",
      "category": "historical_cost",
      "difficulty": "hard",
      "required_tables": [
        "Sales.SalesOrderDetail",
        "Sales.SalesOrderHeader",
        "Production.ProductCostHistory"
      ],
      "required_intermediate_tables": [],
      "acceptable_join_paths": [
        "SalesOrderDetail.SalesOrderID -> SalesOrderHeader.SalesOrderID",
        "SalesOrderDetail.ProductID -> ProductCostHistory.ProductID + 日期区间"
      ],
      "policy_evidence": [
        "POL-COST-002#3.1",
        "POL-COST-002#3.2"
      ],
      "key_conclusion": "匹配 848 行，成本合计 916,047.43（模拟区间口径，待审核）",
      "validation_rules": [
        "区间条件 StartDate <= OrderDate AND (EndDate IS NULL OR OrderDate < EndDate)",
        "日期为 TEXT 同格式字符串比较",
        "不得按 ProductID 直接 JOIN 成本表"
      ],
      "counter_example_key": null,
      "database_id": "adventureworks",
      "reference_sql": "SELECT COUNT(*) AS matched, ROUND(SUM(CAST(ch.\"StandardCost\" AS REAL)),2) AS cost_sum FROM \"Sales.SalesOrderDetail\" d JOIN \"Sales.SalesOrderHeader\" h ON d.\"SalesOrderID\"=h.\"SalesOrderID\" JOIN \"Production.ProductCostHistory\" ch ON ch.\"ProductID\"=d.\"ProductID\" AND ch.\"StartDate\" <= h.\"OrderDate\" AND (ch.\"EndDate\" IS NULL OR h.\"OrderDate\" < ch.\"EndDate\") WHERE h.\"OrderDate\" >= '2023-01-01' AND h.\"OrderDate\" < '2023-02-01'",
      "reference_result": {
        "columns": [
          "matched",
          "cost_sum"
        ],
        "rows": [
          [
            848,
            916047.43
          ]
        ]
      },
      "counter_example": null,
      "split": "dev",
      "reference_sql_verified": true
    },
