    {
      "id": "AW-DEV-001",
      "question": "统计各商品类别的明细净销售额，按销售额从高到低排列。",
      "category": "intermediate_table",
      "difficulty": "medium",
      "required_tables": [
        "Sales.SalesOrderDetail",
        "Production.Product",
        "Production.ProductSubcategory",
        "Production.ProductCategory"
      ],
      "required_intermediate_tables": [
        "Production.ProductSubcategory"
      ],
      "acceptable_join_paths": [
        "SalesOrderDetail.ProductID -> Product.ProductID",
        "Product.ProductSubcategoryID -> ProductSubcategory.ProductSubcategoryID",
        "ProductSubcategory.ProductCategoryID -> ProductCategory.ProductCategoryID"
      ],
      "policy_evidence": [
        "POL-PROD-001#2.1"
      ],
      "key_conclusion": "Bikes 类别净销售额 94,651,172.70 居首，共 4 个类别",
      "validation_rules": [
        "必须经 ProductSubcategory 中间表",
        "ProductSubcategoryID 可空，未分类商品不计入类别汇总",
        "金额列需 CAST AS REAL"
      ],
      "counter_example_key": null,
      "database_id": "adventureworks",
      "reference_sql": "SELECT c.\"Name\" AS category, ROUND(SUM(CAST(d.\"LineTotal\" AS REAL)),2) AS sales FROM \"Sales.SalesOrderDetail\" d JOIN \"Production.Product\" p ON d.\"ProductID\"=p.\"ProductID\" JOIN \"Production.ProductSubcategory\" s ON p.\"ProductSubcategoryID\"=s.\"ProductSubcategoryID\" JOIN \"Production.ProductCategory\" c ON s.\"ProductCategoryID\"=c.\"ProductCategoryID\" GROUP BY c.\"Name\" ORDER BY sales DESC",
      "reference_result": {
        "columns": [
          "category",
          "sales"
        ],
        "rows": [
          [
            "Bikes",
            94651172.7
          ],
          [
            "Components",
            11802593.29
          ],
          [
            "Clothing",
            2120542.52
          ],
          [
            "Accessories",
            1272072.88
          ]
        ]
      },
      "counter_example": null,
