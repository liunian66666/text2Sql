    {
      "id": "AW-TEST-001",
      "question": "统计销售额最高的五个商品子类别。",
      "category": "intermediate_table",
      "difficulty": "medium",
      "required_tables": [
        "Sales.SalesOrderDetail",
        "Production.Product",
        "Production.ProductSubcategory"
      ],
      "required_intermediate_tables": [
        "Production.ProductSubcategory"
      ],
      "acceptable_join_paths": [],
      "policy_evidence": [],
      "key_conclusion": "Road Bikes 43,909,437.51 居首",
      "validation_rules": [
        "必须经 Product 到 ProductSubcategory",
        "金额需 CAST"
      ],
      "counter": null,
      "counter_example": null,
      "database_id": "adventureworks",
      "reference_sql": "SELECT s.\"Name\" AS subcategory, ROUND(SUM(CAST(d.\"LineTotal\" AS REAL)),2) AS sales FROM \"Sales.SalesOrderDetail\" d JOIN \"Production.Product\" p ON d.\"ProductID\"=p.\"ProductID\" JOIN \"Production.ProductSubcategory\" s ON p.\"ProductSubcategoryID\"=s.\"ProductSubcategoryID\" GROUP BY s.\"Name\" ORDER BY sales DESC LIMIT 5",
      "reference_result": {
        "columns": [
          "subcategory",
          "sales"
        ],
        "rows": [
