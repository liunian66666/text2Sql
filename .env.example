# 复制为仓库根目录的 .env 后按需填写；.env 已被 .gitignore 排除，不会进版本库。
# 优先级：真实环境变量 > .env > config/local/ 下的 TOML。
# 全部注释掉时行为与之前完全一致（所有配置都取自 TOML）。
# 变量名只做“覆盖”，不提供新字段：未声明的变量会被忽略。

# 用哪份流水线配置（相对仓库根目录或绝对路径）。
# 不设置时回落到 config/local/config.toml。
# CONFIG_PATH=config/local/demo-fast/config-bird-demo.toml

# OpenAI 兼容端点：覆盖 TOML 里当前 profile 的 api_key / base_url。
# 同时作用于 Agent 的 LLM 与向量模型（embedding / vector_database 两段）。
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 换模型。同一端点下只换模型名会保留 TOML 里声明的 extra_body
# （例如 enable_thinking = false，这是演示档把单题压到 60 秒级的关键）；
# 只有同时换 OPENAI_BASE_URL（跨供应商）才会清空它，避免把自建端点
# 专用参数发给别的服务。
# DEFAULT_LLM_MODEL=deepseek-v4.1-flash-1017

# 向量模型（同时作用于 embedding 与 vector_database 两段）。
# EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# 演示站单请求熔断阈值。
# DEMO_MAX_TOTAL_TOKENS=120000
# DEMO_MAX_SECONDS=600
